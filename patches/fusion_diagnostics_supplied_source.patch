+"""Checks for the RGB-only label builder and the complementarity count (no video, no torch)."""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+TOOLS = Path(__file__).parents[1] / "tools"
+sys.path.insert(0, str(TOOLS))
+
+
+def load(name):
+    spec = importlib.util.spec_from_file_location(name, TOOLS / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def write_seq(root, split, name, ir, rgb):
+    d = Path(root) / split / name
+    d.mkdir(parents=True)
+    (d / "infrared.json").write_text(json.dumps({"exist": [int(b is not None) for b in ir],
+                                                 "gt_rect": [b or [] for b in ir]}))
+    (d / "visible.json").write_text(json.dumps({"exist": [int(b is not None) for b in rgb],
+                                                "gt_rect": [b or [] for b in rgb]}))
+    return d
+
+
+class RgbOnlyLabels(unittest.TestCase):
+    def test_labels_use_rgb_boxes_normalised_by_rgb_size(self):
+        mk = load("make_rgb_only")
+        with tempfile.TemporaryDirectory() as tmp:
+            root, out = Path(tmp) / "raw", Path(tmp) / "yolo"
+            write_seq(root, "val", "v1", [[10, 10, 4, 4], None], [[960, 540, 192, 108], None])
+            (out / "images/visible/val").mkdir(parents=True)
+            (out / "images/visible/val/v1_000000.jpg").write_bytes(b"x")
+            (out / "spla_meta_val.json").write_text(json.dumps(
+                {"v1_000000": {"seq": "v1", "frame": 0}, "v1_000001": {"seq": "v1", "frame": 1}}))
+            mk.main(["--root", str(root), "--out", str(out), "--splits", "val"])
+            pos = (out / "rgbonly/labels/val/v1_000000.txt").read_text().split()
+            neg = (out / "rgbonly/labels/val/v1_000001.txt").read_text()
+            self.assertEqual(pos[0], "0")
+            for got, want in zip(map(float, pos[1:]), [0.55, 0.55, 0.1, 0.1]):
+                self.assertAlmostEqual(got, want, places=5)
+            self.assertEqual(neg, "")
+            img_dir = out / "rgbonly/images/val"
+            # a folder symlink would resolve to images/visible/val and pick up the IR-box labels
+            self.assertFalse(img_dir.is_symlink())
+            self.assertEqual(img_dir.resolve(), img_dir.absolute().resolve())
+            self.assertTrue((img_dir / "v1_000000.jpg").exists())
+            self.assertIn("images/val", (out / "antiuav_rgbonly.yaml").read_text())
+
+
+class Complementarity(unittest.TestCase):
+    def test_counts_and_oracle_gain(self):
+        cp = load("complementarity")
+        box_i, box_r = [100, 100, 10, 10], [500, 300, 30, 30]
+        ir_lab = [box_i] * 4 + [None]
+        rgb_lab = [box_r] * 4 + [box_r]
+        # frame: 0 both hit, 1 IR only, 2 RGB only, 3 neither, 4 IR has no label (excluded)
+        ir_pred = [box_i, box_i, [], [0, 0, 5, 5], []]
+        rgb_pred = [box_r, [], box_r, [], box_r]
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp) / "raw"
+            write_seq(root, "val", "v1", ir_lab, rgb_lab)
+            for run, pred in (("ir", ir_pred), ("rgb", rgb_pred)):
+                (Path(tmp) / run).mkdir()
+                (Path(tmp) / run / "v1_IR.txt").write_text(json.dumps({"res": pred}))
+            outp = Path(tmp) / "c.json"
+            cp.main(["--root", str(root), "--split", "val", "--ir-run", str(Path(tmp) / "ir"),
+                     "--rgb-run", str(Path(tmp) / "rgb"), "--boot", "50", "--out", str(outp)])
+            rep = json.loads(outp.read_text())
+        v = rep["per_video"]["v1"]
+        self.assertEqual((v["n"], v["both"], v["ir_only"], v["rgb_only"], v["neither"]), (4, 1, 1, 1, 1))
+        self.assertAlmostEqual(rep["pooled"]["ir_success"], 0.5)
+        self.assertAlmostEqual(rep["pooled"]["oracle_gain"], 0.25)
+        self.assertAlmostEqual(rep["pooled"]["rescue_share"], 0.5)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff -ruN a/kit/tools/complementarity.py b/kit/tools/complementarity.py
--- a/kit/tools/complementarity.py	1969-12-31 17:00:00.000000000 -0700
+++ b/kit/tools/complementarity.py	2026-10-24 07:50:26.979619856 -0700
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""How often does RGB see the drone when IR misses it? (an upper bound on fusion gains)
+
+Compares an IR detector (A0, boxes in IR pixels) with an RGB-only detector
+(run_sequences.py --input rgb, boxes in RGB pixels), each against its OWN
+modality's labels, on frames where the drone is labelled in both. A frame is
+a success for a modality when its top box has IoU >= --iou with that
+modality's label. Then:
+
+  rescue share  = frames RGB succeeds but IR fails / frames IR fails
+  oracle gain   = success rate if each frame took the better modality,
+                  minus IR's success rate
+
+The oracle gain bounds what any fusion module could add at the detection
+level on these frames; if it is near zero, no fusion design can help. It says
+nothing about box tightness (IoU above the threshold), which SA also rewards.
+Intervals: paired bootstrap over videos.
+
+Usage:
+  python tools/complementarity.py --root /data/Anti-UAV-RGBT --split val \
+      --ir-run results/val/A0_s0 --rgb-run results/val/A0rgb_s0 --out reports/complementarity_val.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from spla.antiuav_io import find_files, list_sequences, read_labels  # noqa: E402
+
+try:
+    from score_runs import iou_xywh
+except ImportError:  # run from elsewhere
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    from score_runs import iou_xywh
+
+
+def frame_success(pred, exist, boxes, thr):
+    """Per-frame success (bool) of a run's top boxes against labels; NaN-free arrays."""
+    n = min(len(pred), len(exist))
+    s = np.zeros(n, bool)
+    for t in range(n):
+        if exist[t] and len(pred[t]) == 4:
+            s[t] = iou_xywh(pred[t], boxes[t]) >= thr
+    return s
+
+
+def counts_for(s_ir, s_rgb, both_exist):
+    m = both_exist[: min(len(s_ir), len(s_rgb), len(both_exist))]
+    a, b = s_ir[: len(m)][m], s_rgb[: len(m)][m]
+    return {"n": int(m.sum()), "both": int(np.sum(a & b)), "ir_only": int(np.sum(a & ~b)),
+            "rgb_only": int(np.sum(~a & b)), "neither": int(np.sum(~a & ~b))}
+
+
+def summarise(c):
+    n = max(c["n"], 1)
+    ir_fail = c["rgb_only"] + c["neither"]
+    return {"frames": c["n"], "ir_success": (c["both"] + c["ir_only"]) / n,
+            "rgb_success": (c["both"] + c["rgb_only"]) / n,
+            "oracle_success": (c["both"] + c["ir_only"] + c["rgb_only"]) / n,
+            "oracle_gain": c["rgb_only"] / n,
+            "rescue_share": c["rgb_only"] / ir_fail if ir_fail else float("nan"),
+            "ir_failures": ir_fail}
+
+
+def add(c1, c2):
+    return {k: c1[k] + c2[k] for k in c1}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--root", required=True)
+    ap.add_argument("--split", default="val")
+    ap.add_argument("--box-format", default="xywh", choices=["xywh", "xyxy"])
+    ap.add_argument("--ir-run", required=True, help="run_sequences output of the IR model (boxes in IR px)")
+    ap.add_argument("--rgb-run", required=True, help="run_sequences --input rgb output (boxes in RGB px)")
+    ap.add_argument("--iou", type=float, default=0.5)
+    ap.add_argument("--boot", type=int, default=10000)
+    ap.add_argument("--out", default="complementarity.json")
+    args = ap.parse_args(argv)
+
+    per = {}
+    for seq in list_sequences(Path(args.root) / args.split, need=("ir_label", "rgb_label")):
+        pi, pr = Path(args.ir_run) / f"{seq.name}_IR.txt", Path(args.rgb_run) / f"{seq.name}_IR.txt"
+        if not (pi.exists() and pr.exists()):
+            continue
+        fs = find_files(seq)
+        ei, bi = read_labels(fs["ir_label"], args.box_format)
+        er, br = read_labels(fs["rgb_label"], args.box_format)
+        n = min(len(ei), len(er))
+        both = (ei[:n] == 1) & (er[:n] == 1)
+        s_ir = frame_success(json.loads(pi.read_text())["res"], ei, bi, args.iou)
+        s_rgb = frame_success(json.loads(pr.read_text())["res"], er, br, args.iou)
+        per[seq.name] = counts_for(s_ir, s_rgb, both)
+    if not per:
+        raise SystemExit("no video has predictions in both runs")
+    names = sorted(per)
+    total = {"n": 0, "both": 0, "ir_only": 0, "rgb_only": 0, "neither": 0}
+    for k in names:
+        total = add(total, per[k])
+    report = {"split": args.split, "iou": args.iou, "videos": len(names), "pooled": summarise(total)}
+    rng = np.random.default_rng(0)
+    boot = {"oracle_gain": [], "rescue_share": []}
+    for _ in range(args.boot):
+        c = {"n": 0, "both": 0, "ir_only": 0, "rgb_only": 0, "neither": 0}
+        for i in rng.integers(0, len(names), len(names)):
+            c = add(c, per[names[i]])
+        s = summarise(c)
+        for k in boot:
+            boot[k].append(s[k])
+    for k, v in boot.items():
+        v = np.asarray(v, float)
+        v = v[np.isfinite(v)]
+        if len(v):
+            report[f"{k}_ci95"] = [float(np.percentile(v, 2.5)), float(np.percentile(v, 97.5))]
+    report["per_video"] = {k: dict(per[k], **summarise(per[k])) for k in names}
+    Path(args.out).write_text(json.dumps(report, indent=1))
+    p = report["pooled"]
+    print(f"videos {len(names)}, frames with both labels {p['frames']}")
+    print(f"IR success {p['ir_success']:.4f}  RGB success {p['rgb_success']:.4f}  best-of-both {p['oracle_success']:.4f}")
+    print(f"oracle gain {p['oracle_gain']:.4f} {report.get('oracle_gain_ci95')}  "
+          f"rescue share of IR failures {p['rescue_share']:.3f} {report.get('rescue_share_ci95')}")
+    print("written:", args.out)
+
+
+if __name__ == "__main__":
+    main()
diff -ruN a/kit/tools/make_rgb_only.py b/kit/tools/make_rgb_only.py
--- a/kit/tools/make_rgb_only.py	1969-12-31 17:00:00.000000000 -0700
+++ b/kit/tools/make_rgb_only.py	2026-10-24 07:51:16.400571628 -0700
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Build an RGB-only detection set from an existing conversion (no frame extraction).
+
+It reuses the stretched RGB frames that convert_antiuav.py already wrote and
+labels them with the RGB boxes (the converter's labels are IR boxes). Train a
+plain YOLO11 on it to measure how much the RGB stream can see on its own:
+
+  OUT/rgbonly/images/<split>/*  hard links to OUT/images/visible/<split>/* (no copies)
+  OUT/rgbonly/labels/<split>/<stem>.txt   YOLO labels from the RGB box at that frame
+  OUT/antiuav_rgbonly.yaml
+
+The stretched frame keeps normalised RGB coordinates, so the RGB box
+normalised by the original RGB size is also correct in the stretched image.
+
+Usage:
+  python tools/make_rgb_only.py --root /data/Anti-UAV-RGBT --out /data/antiuav_yolo
+  python tools/train_spla.py --stage 0 --data /data/antiuav_yolo/antiuav_rgbonly.yaml --seed 0 --name A0rgb_s0
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from spla.antiuav_io import find_files, read_labels  # noqa: E402
+
+
+def video_wh(path, default):
+    try:
+        import cv2
+        cap = cv2.VideoCapture(str(path))
+        wh = (int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)), int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)))
+        cap.release()
+        return wh if wh[0] > 0 and wh[1] > 0 else tuple(default)
+    except Exception:
+        return tuple(default)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--root", required=True, help="original Anti-UAV RGB-T folder")
+    ap.add_argument("--out", required=True, help="folder written by convert_antiuav.py")
+    ap.add_argument("--splits", nargs="+", default=["train", "val", "test"])
+    ap.add_argument("--box-format", default="xywh", choices=["xywh", "xyxy"])
+    ap.add_argument("--rgb-size", nargs=2, type=int, default=[1920, 1080], help="used if a video cannot be read")
+    args = ap.parse_args(argv)
+
+    out = Path(args.out).resolve()
+    base = out / "rgbonly"
+    counts = {}
+    for split in args.splits:
+        meta_p = out / f"spla_meta_{split}.json"
+        src = out / "images" / "visible" / split
+        if not meta_p.exists() or not src.exists():
+            print(f"skip {split}: {meta_p.name} or {src} missing")
+            continue
+        meta = json.loads(meta_p.read_text())
+        # A real folder of per-file links, NOT a folder symlink: Ultralytics resolves the split path,
+        # and a resolved folder symlink would make it read labels/visible/<split> (the converter's
+        # labels) instead of the RGB labels written here.
+        img_dir = base / "images" / split
+        if img_dir.is_symlink():
+            raise SystemExit(f"{img_dir} is a folder symlink from an older run; delete it and rerun")
+        img_dir.mkdir(parents=True, exist_ok=True)
+        for f in src.iterdir():
+            dst = img_dir / f.name
+            if dst.exists() or dst.is_symlink():
+                continue
+            try:
+                os.link(f, dst)               # hard link: no copy, and nothing for a resolve() to follow
+            except OSError:
+                dst.symlink_to(f.resolve())   # other filesystem: file symlink (file paths are not resolved)
+        lab_dir = base / "labels" / split
+        lab_dir.mkdir(parents=True, exist_ok=True)
+        cache = {}
+        n_pos = 0
+        for stem, m in meta.items():
+            seq = m["seq"]
+            if seq not in cache:
+                fs = find_files(Path(args.root) / split / seq)
+                e, b = read_labels(fs["rgb_label"], args.box_format)
+                wh = video_wh(fs["rgb_video"], args.rgb_size) if fs["rgb_video"] else tuple(args.rgb_size)
+                cache[seq] = (e, b, wh)
+            e, b, (wv, hv) = cache[seq]
+            t = m["frame"]
+            line = ""
+            if t < len(e) and e[t] and np.all(np.isfinite(b[t])):
+                x, y, w, h = b[t]
+                cx, cy = np.clip([(x + w / 2) / wv, (y + h / 2) / hv], 0, 1)
+                line = f"0 {cx:.6f} {cy:.6f} {min(w / wv, 1):.6f} {min(h / hv, 1):.6f}\n"
+                n_pos += 1
+            (lab_dir / f"{stem}.txt").write_text(line)
+        counts[split] = {"images": len(meta), "with_rgb_target": n_pos}
+        print(f"{split}: {len(meta)} images, {n_pos} with an RGB target")
+    (out / "antiuav_rgbonly.yaml").write_text(
+        f"path: {base}\ntrain: images/train\nval: images/val\ntest: images/test\nnc: 1\nnames: ['uav']\n")
+    (base / "summary.json").write_text(json.dumps(counts, indent=1))
+    print("written:", out / "antiuav_rgbonly.yaml")
+
+
+if __name__ == "__main__":
+    main()
