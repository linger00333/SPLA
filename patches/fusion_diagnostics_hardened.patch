+            cp.frame_success([[]], [1, 1], [[1, 1, 1, 1]] * 2, 0.5)
+        import numpy as np
+        with self.assertRaises(ValueError):
+            cp.counts_for(np.array([True]), np.array([True, False]), np.array([True, True]))
